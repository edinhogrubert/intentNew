{
  "name": "@intent/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "prisma generate --schema=backend/prisma/schema.prisma && tsx server.ts",
    "build": "npx prisma generate --schema=backend/prisma/schema.prisma && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.0",
    "cors": "^2.8.6",
    "esbuild": "^0.28.2",
    "express": "4.21.2",
    "firebase": "^12.17.1",
    "firebase-admin": "13.5.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "6.19.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.23.13",
    "vitest": "^5.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
