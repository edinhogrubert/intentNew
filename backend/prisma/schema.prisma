generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(uuid()) @db.Uuid
  firebaseUid    String        @unique @map("firebase_uid") @db.VarChar(128)
  email          String?       @unique @db.VarChar(320)
  username       String        @unique @db.VarChar(40)
  displayName    String        @map("display_name") @db.VarChar(120)
  bio            String?       @db.VarChar(500)
  avatarUrl      String?       @map("avatar_url") @db.VarChar(2048)
  status         String        @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  intents        Intent[]
  supports       Support[]
  following      Follow[]      @relation("Follower")
  followers      Follow[]      @relation("Following")
  idempotencyRequests IdempotencyRequest[]
  authoredEvents DomainEvent[] @relation("EventActor")
  receivedNotifications Notification[] @relation("NotificationRecipient")
  notificationActions Notification[] @relation("NotificationActor")
  authoredComments IntentComment[]
  reactions      IntentReaction[]
  intentWatches  IntentWatch[]
  personalContactListsOwned PersonalContactList[] @relation("PersonalContactListOwner")
  personalContactListMemberships PersonalContactListMember[] @relation("PersonalContactListMember")

  @@map("users")
}

model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Restrict)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Restrict)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt(sort: Desc)])
  @@index([followerId, createdAt(sort: Desc)])
  @@map("follows")
}

model Intent {
  id                 String        @id @default(uuid()) @db.Uuid
  creatorId          String        @map("creator_id") @db.Uuid
  type               String        @default("SUPPORT_REVEAL") @db.VarChar(40)
  conditionType      String        @default("SUPPORT") @map("condition_type") @db.VarChar(30)
  status             String        @default("PUBLISHED") @db.VarChar(20)
  visibility         String        @default("PUBLIC") @db.VarChar(20)
  category           String        @default("OTHER") @db.VarChar(40)
  title              String        @db.VarChar(160)
  story              String        @db.Text
  supportGoal        Int           @map("support_goal")
  supportCount       Int           @default(0) @map("support_count")
  revealAt           DateTime?     @map("reveal_at") @db.Timestamptz(3)
  guardianIds        Json          @default("[]") @map("guardian_ids")
  guardianApprovals  Json          @default("[]") @map("guardian_approvals")
  guardianApprovalGoal Int?        @map("guardian_approval_goal")
  revealCiphertext   String        @map("reveal_ciphertext") @db.Text
  revealIv           String        @map("reveal_iv") @db.VarChar(64)
  revealAuthTag      String        @map("reveal_auth_tag") @db.VarChar(64)
  revealVersion      Int           @default(1) @map("reveal_version")
  publishedAt        DateTime?     @map("published_at") @db.Timestamptz(3)
  realizedAt         DateTime?     @map("realized_at") @db.Timestamptz(3)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  creator            User          @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  supports           Support[]
  events             DomainEvent[]
  notifications      Notification[]
  comments           IntentComment[]
  reactions          IntentReaction[]
  watches            IntentWatch[]

  @@index([status, visibility, createdAt(sort: Desc)])
  @@index([conditionType, revealAt])
  @@index([creatorId, createdAt(sort: Desc)])
  @@map("intents")
}

model Support {
  id        String   @id @default(uuid()) @db.Uuid
  intentId  String   @map("intent_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  intent    Intent   @relation(fields: [intentId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([intentId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("supports")
}

model DomainEvent {
  id             String   @id @default(uuid()) @db.Uuid
  intentId       String?  @map("intent_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  type           String   @db.VarChar(80)
  payload        Json
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(180)
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  intent         Intent?  @relation(fields: [intentId], references: [id], onDelete: Restrict)
  actor          User?    @relation("EventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([intentId, occurredAt])
  @@index([actorId, occurredAt])
  @@map("domain_events")
}


model IdempotencyRequest {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  operation   String   @db.VarChar(80)
  key         String   @db.VarChar(128)
  requestHash String   @map("request_hash") @db.VarChar(64)
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, operation, key])
  @@map("idempotency_requests")
}

enum NotificationType {
  FOLLOW_RECEIVED
  SUPPORT_RECEIVED
  GUARDIAN_APPROVAL_RECEIVED
  INTENT_REACTION_RECEIVED
  INTENT_COMMENT_RECEIVED
  INTENT_REALIZED
  INTENT_WATCHED_REALIZED
  USER_FOLLOWED
  GUARDIAN_ACTION
}

model Notification {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  type             NotificationType
  actorId          String           @map("actor_id") @db.Uuid
  intentId         String?          @map("intent_id") @db.Uuid
  deduplicationKey String           @unique @map("deduplication_key") @db.VarChar(180)
  readAt           DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Restrict)
  actor            User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Restrict)
  intent           Intent?          @relation(fields: [intentId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model IntentComment {
  id        String   @id @default(uuid()) @db.Uuid
  intentId  String   @map("intent_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  intent    Intent   @relation(fields: [intentId], references: [id], onDelete: Restrict)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([intentId, createdAt])
  @@index([authorId, createdAt])
  @@map("intent_comments")
}

enum IntentReactionType {
  LIKE
  LOVE
  CELEBRATE
}

model IntentReaction {
  id        String             @id @default(uuid()) @db.Uuid
  intentId  String             @map("intent_id") @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  type      IntentReactionType
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  intent    Intent             @relation(fields: [intentId], references: [id], onDelete: Restrict)
  user      User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([intentId, userId])
  @@index([intentId, type])
  @@index([userId, createdAt(sort: Desc)])
  @@map("intent_reactions")
}

model IntentWatch {
  id        String   @id @default(uuid()) @db.Uuid
  intentId  String   @map("intent_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  intent    Intent   @relation(fields: [intentId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([intentId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("intent_watches")
}

model PersonalContactList {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String   @db.VarChar(80)
  nameKey   String   @map("name_key") @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner     User     @relation("PersonalContactListOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   PersonalContactListMember[]

  @@unique([ownerId, nameKey])
  @@index([ownerId, updatedAt(sort: Desc)])
  @@map("personal_contact_lists")
}

model PersonalContactListMember {
  id        String   @id @default(uuid()) @db.Uuid
  listId    String   @map("list_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  list      PersonalContactList @relation(fields: [listId], references: [id], onDelete: Restrict)
  user      User @relation("PersonalContactListMember", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([listId, userId])
  @@index([listId, createdAt])
  @@index([userId, createdAt])
  @@map("personal_contact_list_members")
}
