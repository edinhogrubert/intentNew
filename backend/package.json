{
  "name": "@intent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test:postgres": "vitest run --config vitest.postgres.config.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "cors": "2.8.5",
    "express": "4.21.2",
    "firebase-admin": "13.5.0",
    "helmet": "8.1.0",
    "pino": "9.9.4",
    "pino-http": "10.5.0",
    "prisma": "6.19.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.5",
    "@types/node": "22.19.1",
    "tsx": "4.21.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
